# Supabase project values. Configure real values in .env.local and Vercel.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Generate a long, random value used only to hash rate-limit identifiers.
ORDER_DETAILS_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Public browser configuration. Restrict both keys/identifiers in their provider consoles.
NEXT_PUBLIC_SITE_URL=https://taprank.co.uk
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-restricted-browser-key
NEXT_PUBLIC_SQUARE_APPLICATION_ID=replace-with-square-application-id
NEXT_PUBLIC_SQUARE_LOCATION_ID=replace-with-square-location-id

# Server-only commerce credentials. Never use NEXT_PUBLIC_ for these values.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=replace-with-square-access-token
SQUARE_WEBHOOK_SIGNATURE_KEY=replace-with-square-webhook-signature-key
SQUARE_WEBHOOK_NOTIFICATION_URL=https://taprank.co.uk/api/square/webhook

# Optional. Only required if a future server-side Places REST request is used.
GOOGLE_PLACES_API_KEY=replace-with-server-only-places-key
